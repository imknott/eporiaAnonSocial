<div class="card mb-4">
    <div class="card-body">
      <div class="d-flex align-items-center mb-2">
        <img src="<%= post.user_avatar %>" alt="Avatar" width="32" height="32" class="rounded-circle me-2">
        <strong><%= post.username %></strong>
        <span class="text-muted ms-auto"><%= new Date(post.created_at).toLocaleString() %></span>
      </div>
      <p><%= post.content %></p>
      <div class="d-flex gap-3 mb-3">
        <button class="btn btn-outline-danger btn-sm" onclick="likePost('<%= post.post_id %>')">
          ❤️ Like (<span id="like-count-<%= post.post_id %>"><%= post.likes || 0 %></span>)
        </button>
        <button class="btn btn-outline-secondary btn-sm" onclick="viewPost('<%= post.post_id %>')">
          💬 Comments
        </button>
      </div>
      <form class="mt-2" onsubmit="submitComment(event, '<%= post.post_id %>')">
        <div class="input-group">
          <input type="text" name="comment" class="form-control" placeholder="Write a comment..." required>
          <button class="btn btn-primary" type="submit">Comment</button>
        </div>
      </form>
      <div id="comments-<%= post.post_id %>" class="mt-2"></div>
    </div>
  </div>