<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Edit Profile</title>
  <link rel="stylesheet" href="/styles/bootstrap.min.css">
  <link rel="stylesheet" href="/stylesheets/style.css">
  <link rel="stylesheet" href="/stylesheets/buttons.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
  <style>
    body {
      transition: background 0.3s ease, color 0.3s ease;
    }

    .avatar-option {
      position: relative;
      border-radius: 10px;
      overflow: hidden;
      cursor: pointer;
      transition: transform 0.2s ease;
      border: 2px solid transparent;
    }

    .avatar-option img {
      border-radius: 10px;
      width: 80px;
      height: 80px;
      object-fit: cover;
      transition: transform 0.2s ease;
    }

    .avatar-option:hover img {
      transform: scale(1.05);
    }

    .avatar-option input:checked + img {
      border: 3px solid #198754;
    }

    .theme-toggle {
      position: absolute;
      top: 1rem;
      right: 1rem;
    }

    .dark-mode {
      background-color: #1e1e1e !important;
      color: #e0e0e0;
    }

    .dark-mode .form-control {
      background-color: #2c2c2c;
      border-color: #444;
      color: #f0f0f0;
    }

    .dark-mode .bg-white {
      background-color: #2b2b2b !important;
    }
  </style>
</head>
<body class="d-flex align-items-center justify-content-center bg-light" id="profile-body">

<!-- Theme Toggle -->
<div class="theme-toggle">
  <button class="btn btn-outline-secondary btn-sm" onclick="toggleTheme()">🌓 Theme</button>
</div>

<!-- Back Button -->
<div class="position-absolute top-0 start-0 m-3">
  <button class="btn btn-success btn-sm" onclick="history.back()">← Go Back</button>
</div>

<!-- Profile Form -->
<div class="col-md-6 col-lg-5 text-center d-flex flex-column justify-content-center align-items-center bg-white rounded-4 shadow-lg p-4">
  <h2 class="mb-4">Edit Username & Avatar</h2>

  <form id="editProfileForm" action="/auth/profile/edit" method="POST">
    <div class="mb-3 text-start w-100">
      <label for="username" class="form-label">New Username</label>
      <input type="text" class="form-control" name="username" value="<%= user.username %>" required>
    </div>

    <div class="mb-3 text-start w-100">
      <label class="form-label d-block mb-2">Select Avatar</label>
      <div class="d-flex flex-wrap gap-2">
        <% const avatars = ['1.png','2.png','3.png','4.png','bear.png','lion.png','deer.png','sloth.png','koala.png','panda.png','alien_robot.png','blueHairRedEyes.png','brownHairGreenEyes.png','darkHairBlueEyes.png','greeneye_girl.png','greyHairRedEye.png','sci-fi-portrait_womanRobot.png','smile_robot.png']; %>
        <% avatars.forEach((img) => { %>
          <label class="avatar-option">
            <input type="radio" name="avatar" value="images/portraits_for_webapp/<%= img %>" <%= user.avatar === 'images/portraits_for_webapp/' + img ? 'checked' : '' %> hidden />
            <img src="/images/portraits_for_webapp/<%= img %>">
          </label>
        <% }) %>
      </div>
    </div>

    <div class="text-center">
      <button type="button" class="btn btn-success px-4" data-bs-toggle="modal" data-bs-target="#authModal">Update</button>
    </div>
  </form>
</div>

<!-- Authenticator Modal -->
<div class="modal fade" id="authModal" tabindex="-1" aria-labelledby="authModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content p-3">
      <div class="modal-header">
        <h5 class="modal-title">Confirm with Authenticator</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body text-start">
        <label for="token" class="form-label">Enter your 2FA code:</label>
        <input type="text" class="form-control" id="tokenInput" name="token" placeholder="123456" required>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="button" class="btn btn-success" onclick="submitWithToken()">Confirm</button>
      </div>
    </div>
  </div>
</div>

<script src="/javascripts/sideBarToggle.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script>
  // Modal submission handler
  function submitWithToken() {
    const token = document.getElementById('tokenInput').value;
    if (!token.trim()) {
      alert("Please enter your authenticator code.");
      return;
    }

    // Add token to form
    const form = document.getElementById('editProfileForm');
    const input = document.createElement('input');
    input.type = 'hidden';
    input.name = 'token';
    input.value = token;
    form.appendChild(input);

    form.submit();
  }

  // Theme toggler with localStorage
  function toggleTheme() {
    const body = document.getElementById('profile-body');
    body.classList.toggle('dark-mode');
    const isDark = body.classList.contains('dark-mode');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  }

  // On page load, apply theme
  window.addEventListener('DOMContentLoaded', () => {
    const savedTheme = localStorage.getItem('theme');
    if (savedTheme === 'dark') {
      document.getElementById('profile-body').classList.add('dark-mode');
    }
  });
</script>
</body>
</html>
