<!DOCTYPE html>
<html>

<head>
    <title>Secure Your Account</title>
    <link rel="stylesheet" href="/styles/bootstrap.min.css">
    <link rel="stylesheet" href="/stylesheets/buttons.css">
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link rel="stylesheet" href="/stylesheets/forms.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
</head>

<body class="auth-bg d-flex align-items-center justify-content-center">

    <!-- Back Button -->
<div class="position-absolute top-0 start-0 m-3">
    <button class="btn btn-outline-secondary btn-sm" onclick="history.back()">
      <i class="bi bi-arrow-left"></i> Back
    </button>
  </div>
  
  <!-- Help Modal Trigger -->
  <div class="position-absolute top-0 start-0 mt-5 ms-3">
    <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="modal" data-bs-target="#authAppModal">
      <i class="bi bi-question-circle me-1"></i> Don’t have an Authenticator App?
    </button>
  </div>
  
  <!-- Auth Card -->
  <div class="qr-wrapper container">
    <div class="qr-card-split d-flex flex-column flex-md-row rounded-4 shadow-sm">
  
      <!-- Right Side: Form -->
<div class="qr-content p-4 d-flex flex-column align-items-center justify-content-center text-center w-100">
    <h2 class="mb-2">Create Your Account</h2>
  
    <!-- Toggle link -->
    <button id="toggleToManual" class="btn btn-link text-decoration-none toggle-manual mb-3" onclick="toggleManual(true)">
        <i class="bi bi-key me-1"></i> Can’t scan? Enter code manually
      </button>      
  
    <!-- QR code -->
    <div id="qr-section" class="mb-3">
      <img src="<%= qrCode %>" alt="QR Code" class="qr-image mb-2" />
    </div>
  
    <!-- Manual code section -->
    <div id="manual-section" style="display: none;" class="text-start w-100 mb-4">
      <h6 class="mb-2">Enter this setup code in your app:</h6>
      <input type="text" id="secretCode" class="form-control text-center mb-2" value="<%= secret %>" readonly>
      <button class="btn btn-outline-secondary btn-sm w-100" onclick="copySecret()" aria-label="Copy setup code to clipboard">
        <i class="bi bi-clipboard me-1"></i> Copy to Clipboard
      </button>
      <small class="text-muted d-block mt-2">Select “Time-based” if prompted.</small>
  
      <button class="btn btn-link text-decoration-none toggle-manual mt-3" onclick="toggleManual(false)">
        <i class="bi bi-arrow-left me-1"></i> Back to QR Code
      </button>
    </div>
  
    <!-- Username input -->
    <div class="mb-3 text-start w-100">
      <label for="customUsername" class="form-label">Your Username</label>
      <input type="text" id="customUsername" name="username" class="form-control"
             value="<%= username %>" required placeholder="Choose a username or keep the anonymous one">
    </div>
  
    <!-- Token form -->
    <form action="/auth/verify" method="POST" class="w-100 mt-3">
      <input type="hidden" name="originalUsername" value="<%= username %>">
      <div class="mb-3">
        <input type="text" class="form-control text-center" name="token" placeholder="Enter 6-digit code" required>
      </div>
      <button type="submit" class="btn btn-outline-primary w-100">Verify</button>
    </form>
  </div>
  
  
  <!-- Modal: Auth App Help -->
  <div class="modal fade" id="authAppModal" tabindex="-1" aria-labelledby="authAppModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
      <div class="modal-content glass-effect">
        <div class="modal-header">
          <h5 class="modal-title" id="authAppModalLabel">Get an Authenticator App</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body text-start">
          <p class="text-muted">Download one of these free apps to get started:</p>
          <div class="d-flex flex-column gap-3">
            <a href="https://apps.apple.com/app/google-authenticator/id388497605" class="btn btn-outline-dark">
              <i class="bi bi-google me-2"></i> Google Authenticator (iOS)
            </a>
            <a href="https://play.google.com/store/apps/details?id=com.google.android.apps.authenticator2" class="btn btn-outline-dark">
              <i class="bi bi-google me-2"></i> Google Authenticator (Android)
            </a>
            <a href="https://apps.apple.com/us/app/authy/id494168017" class="btn btn-outline-primary">
              <i class="bi bi-shield-lock me-2"></i> Authy (iOS)
            </a>
            <a href="https://play.google.com/store/apps/details?id=com.authy.authy" class="btn btn-outline-primary">
              <i class="bi bi-shield-lock me-2"></i> Authy (Android)
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>



    <script src="/javascripts/qrToggle.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<!-- Toast Container -->
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1100">
    <div id="copyToast" class="toast align-items-center text-bg-success border-0" role="alert" aria-live="polite" aria-atomic="true">
      <div class="d-flex">
        <div class="toast-body">
          Secret code copied to clipboard!
        </div>
        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
      </div>
    </div>
  </div>
  
</body>

</html>